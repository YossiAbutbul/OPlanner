{
  // Solution-style root: owns no files itself, only points at the real
  // projects. "files": [] is required — an "include" here would make the
  // root claim src/ as well, colliding with tsconfig.app.json's composite
  // output (TS6305) and dropping files into an inferred project with no
  // jsx option set.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
